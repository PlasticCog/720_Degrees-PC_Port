# DEC T-11 / PDP-11 (no EIS/FPU) SLEIGH specification, generated by tools/gen_pdp11_sleigh.py
define endian=little;
define alignment=2;

define space ram type=ram_space size=2 default;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ R0 R1 R2 R3 R4 R5 SP PC ];
define register offset=0x00 size=1 [ R0l R0h R1l R1h R2l R2h R3l R3h R4l R4h R5l R5h SPl SPh PCl PCh ];
define register offset=0x20 size=1 [ NF ZF VF CF TF IPL ];
define register offset=0x30 size=2 [ PSW ];
define register offset=0x40 size=4 contextreg;

define context contextreg
  guard   = (0,0)
  c_dmode = (1,3)
  c_dreg  = (4,6)
  c_dregb = (4,6)
  c_dregx = (4,6)
  c_draw  = (4,6)
;

define token instr(16)
  op4    = (12,15)
  op7    = (9,15)
  op8    = (8,15)
  op10   = (6,15)
  op13   = (3,15)
  op16   = (0,15)
  smode  = (9,11)
  sreg   = (6,8)
  sregb  = (6,8)
  sregx  = (6,8)
  sregr  = (6,8)
  dmode  = (3,5)
  dreg   = (0,2)
  dregr  = (0,2)
  boff   = (0,7) signed
  sobo   = (0,5)
  trapc  = (0,7)
  ccn    = (3,3)
  ccz    = (2,2)
  ccv    = (1,1)
  ccc    = (0,0)
  ccall  = (0,3)
;
define token ext(16)
  x  = (0,15)
  xs = (0,15) signed
;

attach variables [ sreg sregx dreg c_dreg ] [ R0 R1 R2 R3 R4 R5 SP PC ];
attach variables [ sregb c_dregb ] [ R0l R1l R2l R3l R4l R5l SPl PCl ];

define pcodeop halt;
define pcodeop wait;
define pcodeop reset;
define pcodeop trap_emt;
define pcodeop trap_trap;
define pcodeop trap_bpt;
define pcodeop trap_iot;
define pcodeop mfpt;

macro packpsw() { PSW = zext(IPL << 5) | zext(TF << 4) | zext(NF << 3) | zext(ZF << 2) | zext(VF << 1) | zext(CF); }
macro unpackpsw(v) { CF = (v & 1) != 0; VF = (v & 2) != 0; ZF = (v & 4) != 0; NF = (v & 8) != 0; TF = (v & 0x10) != 0; IPL = (v >> 5) & 7; }
macro nzw(v) { NF = v s< 0; ZF = v == 0; }
macro nzb(v) { NF = v s< 0; ZF = v == 0; }
macro push(v) { SP = SP - 2; *:2 SP = v; }
macro pop(v) { v = *:2 SP; SP = SP + 2; }

# guard prefix: copy destination fields into context so the destination operand
# can consume its extension word after the source operand's extension word
:^instruction is guard=0 & dmode & dregr & instruction [ guard=1; c_dmode=dmode; c_draw=dregr; ] {}

with : guard=1 {


SrcW: sreg            is smode=0 & sreg                 { export sreg; }
SrcW: "("^sreg^")"    is smode=1 & sreg                 { export *:2 sreg; }
SrcW: "#"^x           is smode=2 & sregr=7 ; x          { export *[const]:2 x; }
SrcW: "("^sreg^")+"   is smode=2 & sreg                 { local a = sreg; sreg = sreg + 2; export *:2 a; }
SrcW: "@#"^x          is smode=3 & sregr=7 ; x          { export *:2 x; }
SrcW: "@("^sreg^")+"  is smode=3 & sreg                 { local a = sreg; sreg = sreg + 2; local p:2 = *:2 a; export *:2 p; }
SrcW: "-("^sreg^")"   is smode=4 & sreg                 { sreg = sreg - 2; export *:2 sreg; }
SrcW: "@-("^sreg^")"  is smode=5 & sreg                 { sreg = sreg - 2; local p:2 = *:2 sreg; export *:2 p; }
SrcW: addr            is smode=6 & sregr=7 ; xs         [ addr = inst_start + 4 + xs; ] { export *:2 addr; }
SrcW: xs^"("^sreg^")" is smode=6 & sreg ; xs            { local a = sreg + xs; export *:2 a; }
SrcW: "@"^addr        is smode=7 & sregr=7 ; xs         [ addr = inst_start + 4 + xs; ] { local p:2 = *:2 addr:2; export *:2 p; }
SrcW: "@"^xs^"("^sreg^")" is smode=7 & sreg ; xs        { local a = sreg + xs; local p:2 = *:2 a; export *:2 p; }

SrcB: sregb           is smode=0 & sregb                { export sregb; }
SrcB: "("^sreg^")"    is smode=1 & sreg                 { export *:1 sreg; }
SrcB: "#"^x           is smode=2 & sregr=7 ; x          { local v:1 = x:1; export v; }
SrcB: "("^sreg^")+"   is smode=2 & sreg & (sregr=6)     { local a = sreg; sreg = sreg + 2; export *:1 a; }
SrcB: "("^sreg^")+"   is smode=2 & sreg                 { local a = sreg; sreg = sreg + 1; export *:1 a; }
SrcB: "@#"^x          is smode=3 & sregr=7 ; x          { export *:1 x; }
SrcB: "@("^sreg^")+"  is smode=3 & sreg                 { local a = sreg; sreg = sreg + 2; local p:2 = *:2 a; export *:1 p; }
SrcB: "-("^sreg^")"   is smode=4 & sreg & (sregr=6)     { sreg = sreg - 2; export *:1 sreg; }
SrcB: "-("^sreg^")"   is smode=4 & sreg                 { sreg = sreg - 1; export *:1 sreg; }
SrcB: "@-("^sreg^")"  is smode=5 & sreg                 { sreg = sreg - 2; local p:2 = *:2 sreg; export *:1 p; }
SrcB: addr            is smode=6 & sregr=7 ; xs         [ addr = inst_start + 4 + xs; ] { export *:1 addr; }
SrcB: xs^"("^sreg^")" is smode=6 & sreg ; xs            { local a = sreg + xs; export *:1 a; }
SrcB: "@"^addr        is smode=7 & sregr=7 ; xs         [ addr = inst_start + 4 + xs; ] { local p:2 = *:2 addr:2; export *:1 p; }
SrcB: "@"^xs^"("^sreg^")" is smode=7 & sreg ; xs        { local a = sreg + xs; local p:2 = *:2 a; export *:1 p; }


DstW: c_dreg          is c_dmode=0 & c_dreg             { export c_dreg; }
DstW: "("^c_dreg^")"  is c_dmode=1 & c_dreg             { export *:2 c_dreg; }
DstW: "#"^x           is c_dmode=2 & c_dregx=7 ; x      { export *[const]:2 x; }
DstW: "("^c_dreg^")+" is c_dmode=2 & c_dreg             { local a = c_dreg; c_dreg = c_dreg + 2; export *:2 a; }
DstW: "@#"^x          is c_dmode=3 & c_dregx=7 ; x      { export *:2 x; }
DstW: "@("^c_dreg^")+" is c_dmode=3 & c_dreg            { local a = c_dreg; c_dreg = c_dreg + 2; local p:2 = *:2 a; export *:2 p; }
DstW: "-("^c_dreg^")" is c_dmode=4 & c_dreg             { c_dreg = c_dreg - 2; export *:2 c_dreg; }
DstW: "@-("^c_dreg^")" is c_dmode=5 & c_dreg            { c_dreg = c_dreg - 2; local p:2 = *:2 c_dreg; export *:2 p; }
DstW: addr            is c_dmode=6 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { export *:2 addr; }
DstW: xs^"("^c_dreg^")" is c_dmode=6 & c_dreg ; xs      { local a = c_dreg + xs; export *:2 a; }
DstW: "@"^addr        is c_dmode=7 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { local p:2 = *:2 addr:2; export *:2 p; }
DstW: "@"^xs^"("^c_dreg^")" is c_dmode=7 & c_dreg ; xs  { local a = c_dreg + xs; local p:2 = *:2 a; export *:2 p; }

DstB: c_dregb         is c_dmode=0 & c_dregb            { export c_dregb; }
DstB: "("^c_dreg^")"  is c_dmode=1 & c_dreg             { export *:1 c_dreg; }
DstB: "#"^x           is c_dmode=2 & c_dregx=7 ; x      { export *:1 inst_next; }
DstB: "("^c_dreg^")+" is c_dmode=2 & c_dreg & c_dregx=6 { local a = c_dreg; c_dreg = c_dreg + 2; export *:1 a; }
DstB: "("^c_dreg^")+" is c_dmode=2 & c_dreg             { local a = c_dreg; c_dreg = c_dreg + 1; export *:1 a; }
DstB: "@#"^x          is c_dmode=3 & c_dregx=7 ; x      { export *:1 x; }
DstB: "@("^c_dreg^")+" is c_dmode=3 & c_dreg            { local a = c_dreg; c_dreg = c_dreg + 2; local p:2 = *:2 a; export *:1 p; }
DstB: "-("^c_dreg^")" is c_dmode=4 & c_dreg & c_dregx=6 { c_dreg = c_dreg - 2; export *:1 c_dreg; }
DstB: "-("^c_dreg^")" is c_dmode=4 & c_dreg             { c_dreg = c_dreg - 1; export *:1 c_dreg; }
DstB: "@-("^c_dreg^")" is c_dmode=5 & c_dreg            { c_dreg = c_dreg - 2; local p:2 = *:2 c_dreg; export *:1 p; }
DstB: addr            is c_dmode=6 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { export *:1 addr; }
DstB: xs^"("^c_dreg^")" is c_dmode=6 & c_dreg ; xs      { local a = c_dreg + xs; export *:1 a; }
DstB: "@"^addr        is c_dmode=7 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { local p:2 = *:2 addr:2; export *:1 p; }
DstB: "@"^xs^"("^c_dreg^")" is c_dmode=7 & c_dreg ; xs  { local a = c_dreg + xs; local p:2 = *:2 a; export *:1 p; }

# address operands for JMP/JSR (export the effective address itself)
DstA: "("^c_dreg^")"  is c_dmode=1 & c_dreg             { export c_dreg; }
DstA: "("^c_dreg^")+" is c_dmode=2 & c_dreg             { local a = c_dreg; c_dreg = c_dreg + 2; export a; }
DstA: "@#"^x          is c_dmode=3 & c_dregx=7 ; x      { export *[const]:2 x; }
DstA: "@("^c_dreg^")+" is c_dmode=3 & c_dreg            { local a = c_dreg; c_dreg = c_dreg + 2; local p:2 = *:2 a; export p; }
DstA: "-("^c_dreg^")" is c_dmode=4 & c_dreg             { c_dreg = c_dreg - 2; export c_dreg; }
DstA: "@-("^c_dreg^")" is c_dmode=5 & c_dreg            { c_dreg = c_dreg - 2; local p:2 = *:2 c_dreg; export p; }
DstA: addr            is c_dmode=6 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { export *[const]:2 addr; }
DstA: xs^"("^c_dreg^")" is c_dmode=6 & c_dreg ; xs      { local a = c_dreg + xs; export a; }
DstA: "@"^addr        is c_dmode=7 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { local p:2 = *:2 addr:2; export p; }
DstA: "@"^xs^"("^c_dreg^")" is c_dmode=7 & c_dreg ; xs  { local a = c_dreg + xs; local p:2 = *:2 a; export p; }

# static jump/call targets
DstJ: "@#"^x          is c_dmode=3 & c_dregx=7 ; x      { export *:2 x; }
DstJ: addr            is c_dmode=6 & c_dregx=7 ; xs     [ addr = inst_next + xs; ] { export *:2 addr; }

Rel: dest is boff [ dest = inst_next + boff * 2; ] { export *:2 dest; }
SobT: dest is sobo [ dest = inst_next - sobo * 2; ] { export *:2 dest; }

:CSV_SAVE2 is op16=0x085F ; x=0xF138 { push(R1); push(R2); push(0xF142:2); }
:CSV_SAVE3 is op16=0x085F ; x=0xF144 { push(R1); push(R2); push(R3); push(0xF150:2); }
:CSV_SAVE4 is op16=0x085F ; x=0xF152 { push(R1); push(R2); push(R3); push(R4); push(0xF160:2); }
:CSV_SAVE5 is op16=0x085F ; x=0xF162 { push(R1); push(R2); push(R3); push(R4); push(R5); push(0xF172:2); }
:MOV SrcW,DstW is (op4=1)... & SrcW ; DstW { local s = SrcW; DstW = s; nzw(s); VF = 0; }
:CMP SrcW,DstW is (op4=2)... & SrcW ; DstW { local s = SrcW; local d = DstW; local r = s - d; nzw(r); VF = sborrow(s, d); CF = s < d; }
:BIT SrcW,DstW is (op4=3)... & SrcW ; DstW { local s = SrcW; local d = DstW; local r = s & d; nzw(r); VF = 0; }
:BIC SrcW,DstW is (op4=4)... & SrcW ; DstW { local s = SrcW; local r = DstW & ~s; DstW = r; nzw(r); VF = 0; }
:BIS SrcW,DstW is (op4=5)... & SrcW ; DstW { local s = SrcW; local r = DstW | s; DstW = r; nzw(r); VF = 0; }
:ADD SrcW,DstW is (op4=6)... & SrcW ; DstW { local s = SrcW; local d = DstW; local r = d + s; CF = carry(d, s); VF = scarry(d, s); DstW = r; nzw(r); }
:SUB SrcW,DstW is (op4=14)... & SrcW ; DstW { local s = SrcW; local d = DstW; local r = d - s; CF = d < s; VF = sborrow(d, s); DstW = r; nzw(r); }
:MOVB SrcB,c_dreg is (op4=9 & dmode=0)... & SrcB ; c_dreg { local s = SrcB; c_dreg = sext(s); nzb(s); VF = 0; }
:MOVB SrcB,DstB is (op4=9)... & SrcB ; DstB { local s = SrcB; DstB = s; nzb(s); VF = 0; }
:CMPB SrcB,DstB is (op4=10)... & SrcB ; DstB { local s = SrcB; local d = DstB; local r = s - d; nzb(r); VF = sborrow(s, d); CF = s < d; }
:BITB SrcB,DstB is (op4=11)... & SrcB ; DstB { local s = SrcB; local d = DstB; local r = s & d; nzb(r); VF = 0; }
:BICB SrcB,DstB is (op4=12)... & SrcB ; DstB { local s = SrcB; local r = DstB & ~s; DstB = r; nzb(r); VF = 0; }
:BISB SrcB,DstB is (op4=13)... & SrcB ; DstB { local s = SrcB; local r = DstB | s; DstB = r; nzb(r); VF = 0; }
:XOR sregx,DstW is op7=0x3C & sregx ; DstW { local s = sregx; local r = DstW ^ s; DstW = r; nzw(r); VF = 0; }
:CLR DstW is op10=0x028 ; DstW { DstW = 0; NF = 0; ZF = 1; VF = 0; CF = 0; }
:COM DstW is op10=0x029 ; DstW { local r = ~DstW; DstW = r; nzw(r); VF = 0; CF = 1; }
:INC DstW is op10=0x02A ; DstW { local d = DstW; VF = d == 0x7fff; local r = d + 1; DstW = r; nzw(r); }
:DEC DstW is op10=0x02B ; DstW { local d = DstW; VF = d == 0x8000; local r = d - 1; DstW = r; nzw(r); }
:NEG DstW is op10=0x02C ; DstW { local d = DstW; local r = -d; DstW = r; nzw(r); VF = r == 0x8000; CF = r != 0; }
:ADC DstW is op10=0x02D ; DstW { local d = DstW; local c:2 = zext(CF); local r = d + c; VF = scarry(d, c); CF = carry(d, c); DstW = r; nzw(r); }
:SBC DstW is op10=0x02E ; DstW { local d = DstW; local c:2 = zext(CF); local r = d - c; VF = sborrow(d, c); CF = d < c; DstW = r; nzw(r); }
:TST DstW is op10=0x02F ; DstW { local d = DstW; nzw(d); VF = 0; CF = 0; }
:ROR DstW is op10=0x030 ; DstW { local d = DstW; local c:2 = zext(CF); local r = (d >> 1) | (c << 15); CF = (d & 1) != 0; DstW = r; nzw(r); VF = NF ^ CF; }
:ROL DstW is op10=0x031 ; DstW { local d = DstW; local c:2 = zext(CF); local r = (d << 1) | c; CF = d s< 0; DstW = r; nzw(r); VF = NF ^ CF; }
:ASR DstW is op10=0x032 ; DstW { local d = DstW; local r = d s>> 1; CF = (d & 1) != 0; DstW = r; nzw(r); VF = NF ^ CF; }
:ASL DstW is op10=0x033 ; DstW { local d = DstW; local r = d << 1; CF = d s< 0; DstW = r; nzw(r); VF = NF ^ CF; }
:SXT DstW is op10=0x037 ; DstW { local r:2 = zext(NF) * 0xffff; DstW = r; ZF = NF == 0; VF = 0; }
:SWAB DstW is op10=0x003 ; DstW { local d = DstW; local r = (d >> 8) | (d << 8); DstW = r; local lo:1 = r:1; nzb(lo); VF = 0; CF = 0; }
:CLRB DstB is op10=0x228 ; DstB { DstB = 0; NF = 0; ZF = 1; VF = 0; CF = 0; }
:COMB DstB is op10=0x229 ; DstB { local r = ~DstB; DstB = r; nzb(r); VF = 0; CF = 1; }
:INCB DstB is op10=0x22A ; DstB { local d = DstB; VF = d == 0x7f; local r = d + 1; DstB = r; nzb(r); }
:DECB DstB is op10=0x22B ; DstB { local d = DstB; VF = d == 0x80; local r = d - 1; DstB = r; nzb(r); }
:NEGB DstB is op10=0x22C ; DstB { local d = DstB; local r = -d; DstB = r; nzb(r); VF = r == 0x80; CF = r != 0; }
:ADCB DstB is op10=0x22D ; DstB { local d = DstB; local c:1 = CF; local r = d + c; VF = scarry(d, c); CF = carry(d, c); DstB = r; nzb(r); }
:SBCB DstB is op10=0x22E ; DstB { local d = DstB; local c:1 = CF; local r = d - c; VF = sborrow(d, c); CF = d < c; DstB = r; nzb(r); }
:TSTB DstB is op10=0x22F ; DstB { local d = DstB; nzb(d); VF = 0; CF = 0; }
:RORB DstB is op10=0x230 ; DstB { local d = DstB; local c:1 = CF; local r = (d >> 1) | (c << 7); CF = (d & 1) != 0; DstB = r; nzb(r); VF = NF ^ CF; }
:ROLB DstB is op10=0x231 ; DstB { local d = DstB; local c:1 = CF; local r = (d << 1) | c; CF = d s< 0; DstB = r; nzb(r); VF = NF ^ CF; }
:ASRB DstB is op10=0x232 ; DstB { local d = DstB; local r = d s>> 1; CF = (d & 1) != 0; DstB = r; nzb(r); VF = NF ^ CF; }
:ASLB DstB is op10=0x233 ; DstB { local d = DstB; local r = d << 1; CF = d s< 0; DstB = r; nzb(r); VF = NF ^ CF; }
:MTPS DstB is op10=0x234 ; DstB { local v:1 = DstB; unpackpsw(v); packpsw(); }
:MFPS c_dreg is op10=0x237 & dmode=0 & c_dreg { packpsw(); local v:1 = PSW:1; c_dreg = sext(v); nzb(v); VF = 0; }
:MFPS DstB is op10=0x237 ; DstB { packpsw(); local v:1 = PSW:1; DstB = v; nzb(v); VF = 0; }
:BR Rel is op8=0x01 & Rel { goto Rel; }
:BNE Rel is op8=0x02 & Rel { if (ZF == 0) goto Rel; }
:BEQ Rel is op8=0x03 & Rel { if (ZF != 0) goto Rel; }
:BGE Rel is op8=0x04 & Rel { if (NF == VF) goto Rel; }
:BLT Rel is op8=0x05 & Rel { if (NF != VF) goto Rel; }
:BGT Rel is op8=0x06 & Rel { if (ZF == 0 && NF == VF) goto Rel; }
:BLE Rel is op8=0x07 & Rel { if (ZF != 0 || NF != VF) goto Rel; }
:BPL Rel is op8=0x80 & Rel { if (NF == 0) goto Rel; }
:BMI Rel is op8=0x81 & Rel { if (NF != 0) goto Rel; }
:BHI Rel is op8=0x82 & Rel { if (CF == 0 && ZF == 0) goto Rel; }
:BLOS Rel is op8=0x83 & Rel { if (CF != 0 || ZF != 0) goto Rel; }
:BVC Rel is op8=0x84 & Rel { if (VF == 0) goto Rel; }
:BVS Rel is op8=0x85 & Rel { if (VF != 0) goto Rel; }
:BCC Rel is op8=0x86 & Rel { if (CF == 0) goto Rel; }
:BCS Rel is op8=0x87 & Rel { if (CF != 0) goto Rel; }
:SOB sregx,SobT is op7=0x3F & sregx & SobT { sregx = sregx - 1; if (sregx != 0) goto SobT; }
:JMP DstA is op10=0x001 ; DstA { goto [DstA]; }
:JMP DstJ is op10=0x001 & dmode=6 & dregr=7 ; DstJ { goto DstJ; }
:JMP DstJ is op10=0x001 & dmode=3 & dregr=7 ; DstJ { goto DstJ; }
:JSR sregx,DstJ is op7=0x04 & sregr=7 & sregx & dmode=6 & dregr=7 ; DstJ { local ra:2 = inst_next; push(ra); call DstJ; }
:JSR sregx,DstJ is op7=0x04 & sregr=7 & sregx & dmode=3 & dregr=7 ; DstJ { local ra:2 = inst_next; push(ra); call DstJ; }
:JSR sregx,DstJ is op7=0x04 & sregx & dmode=6 & dregr=7 ; DstJ { local ra:2 = inst_next; push(sregx); sregx = ra; call DstJ; }
:JSR sregx,DstJ is op7=0x04 & sregx & dmode=3 & dregr=7 ; DstJ { local ra:2 = inst_next; push(sregx); sregx = ra; call DstJ; }
:JSR sregx,DstA is op7=0x04 & sregr=7 & sregx ; DstA { local t = DstA; local ra:2 = inst_next; push(ra); call [t]; }
:JSR sregx,DstA is op7=0x04 & sregx ; DstA { local t = DstA; local ra:2 = inst_next; push(sregx); sregx = ra; call [t]; }
:RTS PC is op13=0x0010 & dregr=7 & PC { local t:2 = 0; pop(t); return [t]; }
:RTS dreg is op13=0x0010 & dreg { local t = dreg; pop(dreg); return [t]; }
:RTI is op16=0x0002 { local t:2 = 0; pop(t); local p:2 = 0; pop(p); unpackpsw(p:1); packpsw(); return [t]; }
:RTT is op16=0x0006 { local t:2 = 0; pop(t); local p:2 = 0; pop(p); unpackpsw(p:1); packpsw(); return [t]; }
:HALT is op16=0x0000 { halt(); }
:WAIT is op16=0x0001 { wait(); }
:BPT is op16=0x0003 { trap_bpt(); }
:IOT is op16=0x0004 { trap_iot(); }
:RESET is op16=0x0005 { reset(); }
:MFPT is op16=0x0007 { R0l = 4; }
:EMT trapc is op8=0x88 & trapc { trap_emt(trapc:1); }
:TRAP trapc is op8=0x89 & trapc { trap_trap(trapc:1); }
:NOP is op16=0x00A0 { }
:NOP is op16=0x00B0 { }
:CLC is op16=0x00A1 { CF = 0; }
:SEC is op16=0x00B1 { CF = 1; }
:CLV is op16=0x00A2 { VF = 0; }
:SEV is op16=0x00B2 { VF = 1; }
:CCC "VC" is op16=0x00A3 { VF = 0; CF = 0; }
:SCC "VC" is op16=0x00B3 { VF = 1; CF = 1; }
:CLZ is op16=0x00A4 { ZF = 0; }
:SEZ is op16=0x00B4 { ZF = 1; }
:CCC "ZC" is op16=0x00A5 { ZF = 0; CF = 0; }
:SCC "ZC" is op16=0x00B5 { ZF = 1; CF = 1; }
:CCC "ZV" is op16=0x00A6 { ZF = 0; VF = 0; }
:SCC "ZV" is op16=0x00B6 { ZF = 1; VF = 1; }
:CCC "ZVC" is op16=0x00A7 { ZF = 0; VF = 0; CF = 0; }
:SCC "ZVC" is op16=0x00B7 { ZF = 1; VF = 1; CF = 1; }
:CLN is op16=0x00A8 { NF = 0; }
:SEN is op16=0x00B8 { NF = 1; }
:CCC "NC" is op16=0x00A9 { NF = 0; CF = 0; }
:SCC "NC" is op16=0x00B9 { NF = 1; CF = 1; }
:CCC "NV" is op16=0x00AA { NF = 0; VF = 0; }
:SCC "NV" is op16=0x00BA { NF = 1; VF = 1; }
:CCC "NVC" is op16=0x00AB { NF = 0; VF = 0; CF = 0; }
:SCC "NVC" is op16=0x00BB { NF = 1; VF = 1; CF = 1; }
:CCC "NZ" is op16=0x00AC { NF = 0; ZF = 0; }
:SCC "NZ" is op16=0x00BC { NF = 1; ZF = 1; }
:CCC "NZC" is op16=0x00AD { NF = 0; ZF = 0; CF = 0; }
:SCC "NZC" is op16=0x00BD { NF = 1; ZF = 1; CF = 1; }
:CCC "NZV" is op16=0x00AE { NF = 0; ZF = 0; VF = 0; }
:SCC "NZV" is op16=0x00BE { NF = 1; ZF = 1; VF = 1; }
:CCC is op16=0x00AF { NF = 0; ZF = 0; VF = 0; CF = 0; }
:SCC is op16=0x00BF { NF = 1; ZF = 1; VF = 1; CF = 1; }
} # with guard=1
